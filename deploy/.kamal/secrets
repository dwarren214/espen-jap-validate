# Note: when you add variables to this file you will also need to update the `env: secret` section
# of your `config/deploy.yml` file to make them available in your production deployment.

# Note: The AWS profile must be called 'ocs-misc'

# Kamal config expects the service to be running on this port
PORT=8000

SECRETS=$(kamal secrets fetch --adapter aws_secrets_manager --account ocs-misc ESPEN_PG_PASSWORD ESPEN_MSSQL_PASSWORD ESPEN_API_KEY ESPEN_CAMPAIGN_HUB_KEY)

# Docker postgres
POSTGRES_PASSWORD=$(kamal secrets extract ESPEN_PG_PASSWORD $SECRETS)
DATABASE_URL=postgresql://espen:$POSTGRES_PASSWORD@espen-sql-api-postgres:5432/espen

# Remote MSSQL database
ESPEN_MSSQL_PASSWORD=$(kamal secrets extract ESPEN_MSSQL_PASSWORD $SECRETS)
REMOTE_DATABASE_URL=mssql+pyodbc://dimagi:$ESPEN_MSSQL_PASSWORD@af-ntdp-mssqlsrv.database.windows.net/ESPEN_ProcessedData?driver=ODBC+Driver+18+for+SQL+Server

API_KEY=$(kamal secrets extract ESPEN_API_KEY $SECRETS)
ESPEN_CAMPAIGN_HUB_KEY=$(kamal secrets extract ESPEN_CAMPAIGN_HUB_KEY $SECRETS)

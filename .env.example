# copy this to `.env` and update for local dev

DATABASE_URL=postgres://user:password@localhost:5432/dbname
API_KEY=secret api key

OPENAI_API_KEY=your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1  # optional, only if you're overriding the default

# Guardrail defaults (server-side enforcement only; callers cannot override these limits)
MAX_RETURNED_ROWS=5000
MAX_RETURNED_BYTES=400000
PREVIEW_ROW_COUNT=50

# Database Connection Pool Configuration
# These settings help prevent connection errors and improve reliability
DB_POOL_SIZE=5                    # Base pool size (connections kept alive)
DB_POOL_MAX_OVERFLOW=10           # Additional connections during traffic bursts
DB_POOL_RECYCLE=3600              # Recycle connections after 1 hour (prevents stale connections)
DB_POOL_PRE_PING=true             # Validate connections before use (prevents 08S01 errors)
DB_ECHO_POOL=false                # Set to "debug" for detailed pool logging

# Retry Configuration (for transient connection errors)
DB_RETRY_ATTEMPTS=3               # Number of retry attempts for transient errors
DB_RETRY_MIN_WAIT=1               # Minimum wait time in seconds between retries
DB_RETRY_MAX_WAIT=10              # Maximum wait time in seconds between retries
